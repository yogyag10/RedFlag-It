{
  "manifest_version": 3,
  "name": "Vancouver Rental Scam Shield",
  "version": "0.1.0",
  "description": "Review Vancouver rental listings for common fraud signals before you contact a landlord.",
  "minimum_chrome_version": "116",
  "permissions": ["activeTab", "scripting", "storage"],
  "host_permissions": [
    "https://*.craigslist.org/*",
    "https://www.facebook.com/marketplace/*",
    "http://127.0.0.1:8000/*",
    "http://localhost:8000/*"
  ],
  "optional_host_permissions": ["http://*/*", "https://*/*"],
  "action": {
    "default_title": "Check this rental listing",
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/shield-16.png",
      "32": "icons/shield-32.png",
      "128": "icons/shield-128.png"
    }
  },
  "icons": {
    "16": "icons/shield-16.png",
    "32": "icons/shield-32.png",
    "128": "icons/shield-128.png"
  },
  "content_scripts": [
    {
      "matches": ["https://*.craigslist.org/*", "https://www.facebook.com/marketplace/*"],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ],
  "options_page": "options.html"
}
